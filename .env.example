NODE_ENV=development
PORT=3333
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
# URL pública do frontend nos QR Codes (se vazia, usa a primeira origem de CORS).
PUBLIC_APP_URL=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=condominio
DATABASE_PASSWORD=condominio
DATABASE_NAME=condominio
DATABASE_SSL=false
# Mantenha desligado fora de investigações: o log do TypeORM imprime as queries
# com CPF, RG, telefones e a assinatura dos moradores.
DATABASE_LOGGING=false

# Redis — cache-aside (membership, condomínio, usuário, CEP/geocode).
# Suba com `docker compose up -d redis` (porta 6379).
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=condogest:

# Cloudflare R2 — único armazenamento de arquivos anexados (obrigatório).
# Pastas: condominiums/{id}/payables|documents|signatures/...
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=condominio-app
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Troque por um segredo próprio antes de ir para produção (mínimo de 32 caracteres).
JWT_SECRET=troque-este-segredo-de-desenvolvimento-0123456789
# Segredo dedicado ao JWT de funcionários (ponto). Em produção, use valor distinto.
# JWT_STAFF_SECRET=outro-segredo-staff-com-pelo-menos-32chars
JWT_EXPIRES_IN_SECONDS=28800
# Material AES-256-GCM para API keys Asaas (opcional; deriva de JWT_SECRET se omitido).
# ENCRYPTION_KEY=chave-de-criptografia-com-pelo-menos-32c
# Retenção de selfies de ponto no R2 (dias).
PUNCH_SELFIE_RETENTION_DAYS=90
FORMER_RESIDENT_RETENTION_DAYS=1825

# Contas criadas/atualizadas por `npm run seed` (só no `.env` local / servidor — não versionar senhas).
#
# Papéis NÃO dependem da ordem do array. O seed aplica por e-mail fixo:
#   - holanda_rodrigues@hotmail.com  → SYSTEM_OWNER (único dono/gestor da plataforma) + plano Gestor
#   - hellennamello@hotmail.com      → plano Prime ACTIVE, OWNER do condo demo, SEM SYSTEM_OWNER
# Demais e-mails (se houver)         → Lite + OPERATOR no demo, sem SYSTEM_OWNER
#
# Exemplo de produção (troque as senhas):
# SEED_ACCOUNTS=[{"name":"Holanda Rodrigues","email":"holanda_rodrigues@hotmail.com","password":"..."},{"name":"Hellen Namello","email":"hellennamello@hotmail.com","password":"..."}]
SEED_ACCOUNTS=[{"name":"Nome da Pessoa","email":"pessoa@exemplo.com.br","password":"defina-uma-senha-forte"}]

# Servidor de e-mail que envia o código da segunda etapa do login.
# SMTP_SECURE=true só em portas com TLS implícito (465); na 587 deixe false.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@exemplo.com.br
SMTP_PASS=senha-do-e-mail
MAIL_FROM="CondoGest <contato@exemplo.com.br>"
# Validade do código, em segundos (mínimo 60, máximo 3600).
LOGIN_CODE_TTL_SECONDS=600

# Avisos de novos chamados de suporte (área de tickets).
SUPPORT_NOTIFY_EMAIL=holanda_rodrigues@hotmail.com

# Assinatura SaaS da plataforma (valores de referência; checkout Stripe ainda não está ligado ao código).
# Lite R$ 59 (até 10 unidades) · Prime R$ 109 (unidades ilimitadas) · Gestor R$ 209 (vários condomínios).
# Fonte de verdade da landing: frontend/src/features/marketing/model/plans.ts
BILLING_TRIAL_DAYS=30
BILLING_CURRENCY=BRL
BILLING_LITE_PRICE_CENTS=5900
BILLING_PRIME_PRICE_CENTS=10900
BILLING_GESTOR_PRICE_CENTS=20900
# STRIPE_PRICE_ID = Lite · STRIPE_PRIME_PRICE_ID · STRIPE_GESTOR_PRICE_ID
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRIME_PRICE_ID=
STRIPE_GESTOR_PRICE_ID=

# Cobranças PIX via Asaas (chave por condomínio na UI; webhook global abaixo).
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
